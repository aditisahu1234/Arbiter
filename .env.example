# Arbiter Environment Configuration

# Environment mode: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Metadata OLTP)
DATABASE_URL=postgresql+asyncpg://arbiter_user:arbiter_password@localhost:5432/arbiter_db
DATABASE_URL_SYNC=postgresql://arbiter_user:arbiter_password@localhost:5432/arbiter_db

# Redis (Caching & Short-lived computed results)
REDIS_URL=redis://localhost:6337/0

# DuckDB (OLAP Analytics)
DUCKDB_PATH=data/arbiter_analytics.duckdb

# Data Storage Paths
DATA_RAW_DIR=data/raw
DATA_NORMALIZED_DIR=data/normalized
DATA_FACTORS_DIR=data/factors
DATA_QUARANTINE_DIR=data/quarantine

# Market Data Provider
MARKET_DATA_PROVIDER=yahoo
YAHOO_REQUEST_DELAY_SECONDS=0.2
YAHOO_BATCH_SIZE=20

# Scheduler
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Kolkata
DAILY_INGESTION_CRON_HOUR=16
DAILY_INGESTION_CRON_MINUTE=0

# Security & Authentication
SECRET_KEY=arbiter_dev_insecure_secret_key_change_in_production_32bytes_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# API Server
PORT=8000
HOST=0.0.0.0
